{
  "expo": {
    "name": "NMIX",
    "slug": "nmix",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/nmix-icon-v2.png",

    "android": {
      "package": "com.lxz.nmix",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/nmix-adaptive-v2.png",
        "backgroundColor": "#07110f"
      }
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07110f",
          "image": "./assets/nmix-splash-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
